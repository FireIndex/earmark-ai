# Copy this file to .env and fill in your own values.  .env is git-ignored.

# ── LLM: pick one provider ────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Largest transcript (characters) sent in one LLM call.
# 20000 fits Groq's free tier; raise to 200000 on a paid plan.
LLM_MAX_CHARS=20000

# ── Speech-to-text ────────────────────────────────────────────────────────────
# tiny | base | small | medium | large
WHISPER_MODEL=small

# ── YouTube sign-in (optional; only for videos that need it) ──────────────────
# YTDLP_COOKIES_FILE=cookies.txt
# YTDLP_COOKIES_BROWSER=firefox
